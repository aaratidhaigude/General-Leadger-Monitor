# ==============================================================================
# Python & Environment Ignore Rules
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
ENV*/
venv*/

# Environment variables & secrets (prevent accidental credential leaks)
.env
.env.local
.env.*.local
*.key
*.pem
credentials.json

# Local Run Artifacts and Caches
results/*.xlsx
results/*.json
!results/.gitkeep
.pytest_cache/
.coverage
htmlcov/

# Cloud Foundry & BTP Deployment Temp Files
.cf/
*.log
cf-cli*.log

# Editor & OS Metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
