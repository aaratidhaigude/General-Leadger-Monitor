# ==============================================================================
# Python & Environment Ignore Rules
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
.env.local
*.key
*.pem

# Local Run Artifacts and Caches
results/*.xlsx
results/*.json
!results/.gitkeep
.pytest_cache/

# Cloud Foundry & BTP Deployment Temp Files
.cf/
*.log

# Editor & OS Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
